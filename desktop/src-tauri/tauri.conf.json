{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "offcard",
  "version": "0.13.2",
  "identifier": "io.github.imsoumya18.offcard",
  "build": { "frontendDist": "../panel" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "offcard",
        "url": "index.html",
        "width": 392,
        "height": 326,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../docs/icon.png", "../../docs/icon.ico"]
  }
}
